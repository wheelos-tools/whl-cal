+void Gril_Calib::dump_batch_trace_v1(const string &path, const int &orig_odom_freq, const int &cut_frame_num,
+                                     const double &timediff_imu_wrt_lidar, const double &move_start_time) const {
+    ofstream trace(path, ios::out);
+    trace << setprecision(17);
+    trace << "GRIL_BATCH_TRACE 1\n"
+          << "orig_odom_freq " << orig_odom_freq << "\n"
+          << "cut_frame_num " << cut_frame_num << "\n"
+          << "timediff_imu_wrt_lidar " << timediff_imu_wrt_lidar << "\n"
+          << "move_start_time " << move_start_time << "\n"
+          << "imu_states " << IMU_state_group_ALL.size() << "\n";
+
+    for (const auto &state : IMU_state_group_ALL) {
+        trace << "imu " << state.timeStamp;
+        for (int row = 0; row < 3; ++row)
+            for (int col = 0; col < 3; ++col)
+                trace << " " << state.rot_end(row, col);
+        trace << " " << state.pos_end.transpose()
+              << " " << state.ang_vel.transpose()
+              << " " << state.linear_vel.transpose()
+              << " " << state.ang_acc.transpose()
+              << " " << state.linear_acc.transpose() << "\n";
+    }
+
+    trace << "lidar_states " << Lidar_state_group.size() << "\n";
+    for (const auto &state : Lidar_state_group) {
+        trace << "lidar " << state.timeStamp;
+        for (int row = 0; row < 3; ++row)
+            for (int col = 0; col < 3; ++col)
+                trace << " " << state.rot_end(row, col);
+        trace << " " << state.pos_end.transpose()
+              << " " << state.ang_vel.transpose()
+              << " " << state.linear_vel.transpose()
+              << " " << state.ang_acc.transpose()
+              << " " << state.linear_acc.transpose() << "\n";
+    }
+
+    trace << "ground_constraints " << Lidar_wrt_ground_group.size() << "\n";
+    for (int i = 0; i < Lidar_wrt_ground_group.size(); ++i)
+        trace << "ground " << Lidar_wrt_ground_group[i].w() << " " << Lidar_wrt_ground_group[i].x() << " "
+              << Lidar_wrt_ground_group[i].y() << " " << Lidar_wrt_ground_group[i].z() << " "
+              << IMU_wrt_ground_group[i].w() << " " << IMU_wrt_ground_group[i].x() << " "
+              << IMU_wrt_ground_group[i].y() << " " << IMU_wrt_ground_group[i].z() << " "
+              << normal_vector_wrt_lidar_group[i].transpose() << " "
+              << distance_Lidar_wrt_ground_group[i] << "\n";
+    trace << "END\n";
+}
