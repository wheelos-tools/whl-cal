+void write_ground_trace_cloud(
+        const char *label,
+        const pcl::PointCloud<pcl::PointXYZI> &cloud) {
+    fout_ground_trace << label << " " << cloud.size() << "\n";
+    for (const auto &point : cloud.points)
+        fout_ground_trace << "point "
+                          << point.x << " " << point.y << " " << point.z << " "
+                          << point.intensity << "\n";
+}
+
+void write_ground_trace(uint64_t timestamp_ns) {
+    if (scan_count > 21)
+        return;
+    fout_ground_trace << "scan " << scan_count << " " << timestamp_ns << "\n";
+    write_ground_trace_cloud("ground", ground_points);
+    write_ground_trace_cloud("nonground", non_ground_points);
+    fout_ground_trace << "end_scan\n";
+}
