+void write_frontend_cv_cloud(const char *label, const PointCloudXYZI &cloud) {
+    fout_frontend_cv_trace << label << " " << cloud.size() << "\n";
+    for (const auto &point : cloud.points) {
+        fout_frontend_cv_trace << "point "
+                               << point.x << " " << point.y << " " << point.z << " "
+                               << point.intensity << " " << point.curvature << "\n";
+    }
+}
+
+void write_frontend_cv_state(const char *label, const StatesGroup &value) {
+    fout_frontend_cv_trace << label;
+    for (int row = 0; row < 3; ++row)
+        for (int col = 0; col < 3; ++col)
+            fout_frontend_cv_trace << " " << value.rot_end(row, col);
+    for (int index = 0; index < 3; ++index)
+        fout_frontend_cv_trace << " " << value.pos_end(index);
+    for (int row = 0; row < 3; ++row)
+        for (int col = 0; col < 3; ++col)
+            fout_frontend_cv_trace << " " << value.offset_R_L_I(row, col);
+    for (int index = 0; index < 3; ++index)
+        fout_frontend_cv_trace << " " << value.offset_T_L_I(index);
+    for (int index = 0; index < 3; ++index)
+        fout_frontend_cv_trace << " " << value.vel_end(index);
+    for (int index = 0; index < 3; ++index)
+        fout_frontend_cv_trace << " " << value.bias_g(index);
+    for (int index = 0; index < 3; ++index)
+        fout_frontend_cv_trace << " " << value.bias_a(index);
+    for (int index = 0; index < 3; ++index)
+        fout_frontend_cv_trace << " " << value.gravity(index);
+    for (int row = 0; row < DIM_STATE; ++row)
+        for (int col = 0; col < DIM_STATE; ++col)
+            fout_frontend_cv_trace << " " << value.cov(row, col);
+    fout_frontend_cv_trace << "\n";
+}
+
+void write_frontend_cv_trace(
+        const MeasureGroup &measure,
+        const StatesGroup &before,
+        const StatesGroup &after,
+        const PointCloudXYZI &output) {
+    frontend_cv_package_count++;
+    if (frontend_cv_package_count > 25)
+        return;
+    fout_frontend_cv_trace << "package " << frontend_cv_package_count << " "
+                           << measure.lidar_beg_time << " " << lidar_end_time << "\n";
+    fout_frontend_cv_trace << "imu " << measure.imu.size() << "\n";
+    for (const auto &imu : measure.imu)
+        fout_frontend_cv_trace << "imu_sample "
+                               << imu->header.stamp.toSec() << "\n";
+    write_frontend_cv_state("before", before);
+    write_frontend_cv_cloud("input", *measure.lidar);
+    write_frontend_cv_state("after", after);
+    write_frontend_cv_cloud("output", output);
+    fout_frontend_cv_trace << "end_package\n";
+}
